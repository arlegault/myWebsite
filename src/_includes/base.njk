<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}
</head>
<body>
  <div class="center">
    <header>
      {% if section == "home" %}
      <h1>{{ site.name }}</h1>
      {% else %}
      <h1><a href="index.html">{{ site.name }}</a></h1>
      {% endif %}
      {% include "nav.njk" %}
    </header>
    <main>
      {{ content | safe }}
    </main>
  </div>
  <script>
    // Record the click without canceling navigation, so target="_blank" still opens a new tab.
    document.addEventListener("click", function (event) {
      var node = event.target;
      if (!node) return;
      if (node.nodeType !== 1) node = node.parentElement;
      var link = node && node.closest('a[target="_blank"]');
      if (!link || typeof gtag !== "function") return;
      gtag("event", "click", {
        event_category: "outbound",
        event_label: "external_link"
      });
    });
  </script>
</body>
</html>
